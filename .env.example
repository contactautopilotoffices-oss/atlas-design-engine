# ATLAS Design Engine environment. Copy to .env (or .env.local) and fill in.
# Never commit real values. All of these are read on the server only.

# --- Higgsfield (image generation) -------------------------------------------
# Either the documented pair:
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# ...or one combined value in the form <key id>:<key secret>
HIGGSFIELD_API_KEY=
# (The older misspelt name HIGGSFIELF_API_KEY is also accepted, so an existing .env keeps working.)
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# --- OpenAI (image generation: GPT Image 2.6 / 1.5 / 1 Mini) -----------------
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com

# Claude (Anthropic) key. Used to find rooms on PDF/image floor plans and analyse reference images.
# DXF floor plans are read directly and do not need it.
ANTHROPIC_API_KEY=
# Optional. Which Claude models read plans and analyse reference images.
ATLAS_PLAN_MODEL=claude-opus-5-5
ATLAS_VISION_MODEL=claude-sonnet-5-5

# --- Staff access (Studio) ---------------------------------------------------
# Leave both empty only for local development. In production Studio stays locked without them.
ATLAS_ADMIN_PASSCODE=
ATLAS_DESIGNER_PASSCODE=
# Long random string used to sign staff cookies. Required in production.
ATLAS_SESSION_SECRET=

# --- Persistence ---------------------------------------------------------------
# auto = Supabase when configured, otherwise .atlas-design/store.json locally
ATLAS_PERSISTENCE=auto
# Optional: where the local store lives (default ./.atlas-design)
ATLAS_DATA_DIR=
ATLAS_MAX_UPLOAD_MB=100

# --- Supabase (cloud database + storage) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (later stage; nothing is sent unless both are set) --------------
RESEND_API_KEY=
ATLAS_EMAIL_FROM=

# --- Optional paid live test (spends Higgsfield credits) -------------------
ATLAS_ENABLE_LIVE_HIGGSFIELD_TEST=
